{
  "name": "ard-almultaqa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "e2e": "playwright test",
    "vercel-build": "prisma generate && prisma migrate deploy && ([ \"$SEED_DEMO\" = \"1\" ] && tsx prisma/seed.ts || true) && next build",
    "demo:build": "tsx scripts/build-demo.ts docs/demo"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@sparticuz/chromium": "^153.0.0",
    "argon2": "^0.45.1",
    "exceljs": "^4.4.0",
    "next": "^15.5.28",
    "otplib": "^12.0.1",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  }
}
